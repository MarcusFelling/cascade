{
  "name": "cascade",
  "private": true,
  "version": "0.0.0",
  "description": "A deterministic distributed-systems lab with fault injection, incident replay, and resilience comparisons.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.44.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "seedrandom": "3.0.5",
    "simts": "1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/seedrandom": "3.0.8",
    "@vitejs/plugin-react": "5.1.2",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
